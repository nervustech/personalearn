# Supabase — copy to .env.local and fill in real values (never commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon / publishable key (safe for browser). Either name works in code:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel (Project Settings → Environment Variables):
# Required for Preview AND Production — enable BOTH scopes when adding each var:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  (or NEXT_PUBLIC_PUBLISHABLE_KEY — same value)
# Runtime fallbacks (work in middleware without rebuild; same values as above):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
# Optional server-only: SUPABASE_SERVICE_ROLE_KEY
# After changing NEXT_PUBLIC_* vars, redeploy. Check /api/health on preview for diagnostics.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E2E (optional — local/staging only; never use production credentials in CI until secrets are configured)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Sentry (optional — omit locally to disable error reporting)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Vercel/CI only — enables source map uploads during build (never commit)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=nervus
SENTRY_PROJECT=javascript-nextjs
# Verify locally (dev only): npm run dev → http://localhost:3000/dev/sentry-test

# AI (Sprint 2+)
OPENAI_API_KEY=your-openai-key

# PSL-18 — Supabase Auth dashboard setup:
# 1. Authentication → Providers → enable Google OAuth (Google Cloud client ID + secret)
# 2. Authentication → URL Configuration:
#    Site URL: http://localhost:3000 (and your Vercel production URL)
#    Redirect URLs: http://localhost:3000/auth/callback, https://<preview>.vercel.app/auth/callback
# 3. Run supabase/migrations/20260621_init_schema.sql — includes handle_new_user trigger
