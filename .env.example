# Supabase — copy to .env.local and fill in real values (never commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon / publishable key (safe for browser). Either name works in code:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_PUBLISHABLE_KEY=your-anon-key
# Server-only — required for Gemini Batch poll + live evaluate (never expose to browser/middleware)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel (Project Settings → Environment Variables):
# Required for Preview AND Production — enable BOTH scopes when adding each var:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  (or NEXT_PUBLIC_PUBLISHABLE_KEY — same value)
# Runtime fallbacks (work in middleware without rebuild; same values as above):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
# Server-only (Production + Preview): SUPABASE_SERVICE_ROLE_KEY
# After changing NEXT_PUBLIC_* vars, redeploy. Check /api/health on preview for diagnostics.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E2E (optional — local/staging only; never commit real credentials)
E2E_TEST_EMAIL=teacher@example.com
E2E_TEST_PASSWORD=your-e2e-password

# Sentry (optional — omit locally to disable error reporting)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Vercel/CI only — enables source map uploads during build (never commit)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=nervus
SENTRY_PROJECT=javascript-nextjs
# Verify locally (dev only): npm run dev → http://localhost:3000/dev/sentry-test

# AI (Sprint 2+) — server-only; never expose to the browser
VOYAGE_API_KEY=your-voyage-key
VOYAGE_EMBEDDING_MODEL=voyage-3.5
DEEPSEEK_API_KEY=your-deepseek-key
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
# Optional — chat experiments only; not used for vision (see ADR-003)
XAI_API_KEY=your-xai-key
CHAT_PROVIDER=deepseek

# Vision tier (ADR-003 / ADR-005) — server-only; read in src/lib/ai/vision-model.ts
# EVAL_VISION_MODEL=gemini-3.1-flash-lite
# EVAL_VISION_ESCALATION=1
# EVAL_VISION_ESCALATION_MODEL=gemini-2.5-pro

# Direct multimodal eval (ADR-005) — Gemini Batch API + cron poll
# Required in Production — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret

# Optional — teaching-aid image gen model (default gemini-2.5-flash-image; PSL-83)
# IMAGE_GENERATION_MODEL=gemini-2.5-flash-image
# Legacy Imagen ids are blocked for new Gemini API keys — do not use as default.

# PSL-18 — Supabase Auth dashboard setup:
# 1. Authentication → Providers → enable Google OAuth (Google Cloud client ID + secret)
# 2. Authentication → URL Configuration (dev project — local + Vercel preview):
#    Site URL: https://personalearndev.vercel.app
#    Redirect URLs (use ** so ?next= query params match — see Supabase Vercel docs):
#      http://localhost:3000/**
#      https://personalearndev.vercel.app/**
#      https://*-.vercel.app/**
# 3. Prod project: Site URL https://personalearn.vercel.app, redirect https://personalearn.vercel.app/**
# 4. Run supabase/migrations/20260621_init_schema.sql — includes handle_new_user trigger
